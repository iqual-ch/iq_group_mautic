{
  "name": "iqual/iq_group_mautic",
  "description": "Iqual Group Mautic Integration",
  "type": "drupal-custom-module",
  "repositories": [
    {
      "type": "composer",
      "url": "https://github.com/iqual-ch/iq_group_mautic"
    }
  ],
  "require": {
    "php": "^8.1",
    "drupal/core": "^10 || ^11",
    "iqual/iq_group": "^4.4",
    "drupal/mautic_api": "^2.0"
  },
  "extra": {
    "patches": {
      "drupal/mautic_api": {
        "#3340224: Allow contacts to be edited and deleted through the service": "https://git.drupalcode.org/project/mautic_api/-/merge_requests/1.diff"
      },
      "mautic/api-library": {
        "Fix PSR Logger incompatibility": "https://github.com/mautic/api-library/files/14497246/mautic_api_3.1.0_psr_log_v3.PATCH"
      }
    }
  }
}
